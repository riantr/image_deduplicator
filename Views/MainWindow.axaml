<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Deduplicator.ViewModels"
        xmlns:models="using:Deduplicator.Models"
        xmlns:converters="using:Deduplicator.Converters"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="Deduplicator.Views.MainWindow"
        Title="图像去重工具"
        Width="1400" Height="800"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="9">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:MultiplyConverter x:Key="MultiplyConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- 全局样式 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="9" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        

        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#cccccc" />
            <Setter Property="Foreground" Value="white" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- 按钮颜色样式 -->
        <Style Selector="Button.load">
            <Setter Property="Background" Value="#2196F3" />
        </Style>

        <Style Selector="Button.calculate">
            <Setter Property="Background" Value="#4CAF50" />
        </Style>

        <Style Selector="Button.compare">
            <Setter Property="Background" Value="#9C27B0" />
        </Style>

        <Style Selector="Button.stop">
            <Setter Property="Background" Value="#f44336" />
        </Style>

        <Style Selector="Button.execute">
            <Setter Property="Background" Value="#2196F3" />
        </Style>

        <Style Selector="Button.undo">
            <Setter Property="Background" Value="#FF9800" />
        </Style>

        <Style Selector="Button.delete">
            <Setter Property="Background" Value="#f44336" />
        </Style>

        <Style Selector="Button.navigate">
            <Setter Property="Background" Value="#607D8B" />
            <Setter Property="Height" Value="35" />
        </Style>

        <Style Selector="Button.browse">
            <Setter Property="Background" Value="#9E9E9E" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        

        <!-- TextBox 样式 -->
        <Style Selector="TextBox">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#ccc" />
        </Style>

        <!-- Slider 样式 -->
        <Style Selector="Slider">
            <Setter Property="Margin" Value="5,0" />
        </Style>

        <!-- Label 样式 -->
        <Style Selector="Label">
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- ProgressBar 样式 -->
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <!-- TabControl 样式 -->
        <Style Selector="TabControl">
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="*, 450">
        <!-- 左侧控制面板 -->
        <ScrollViewer Grid.Column="0">
            <StackPanel Margin="10" Spacing="10">
                
                <!-- 目录设置区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel Spacing="5">
                        <TextBlock Text="目录设置" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <Grid ColumnDefinitions="*, 80">
                            <TextBox Grid.Column="0"
                                   Watermark="输入目录"
                                   Text="{Binding InputDirectory}" />
                            <Button Grid.Column="1"
                                  Content="浏览..."
                                  Classes="browse"
                                  Click="BrowseInputDirectory_Click"
                                  Margin="5,0,0,0" />
                        </Grid>
                        <Grid ColumnDefinitions="*, 80">
                            <TextBox Grid.Column="0"
                                   Watermark="输出目录"
                                   Text="{Binding OutputDirectory}" />
                            <Button Grid.Column="1"
                                  Content="浏览..."
                                  Classes="browse"
                                  Click="BrowseOutputDirectory_Click"
                                  Margin="5,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 算法选项卡 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="算法设置" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <TabControl SelectedIndex="{Binding CurrentAlgorithm}">
                        
                        <!-- Hash 算法 -->
                        <TabItem Header="Hash">
                            <StackPanel Spacing="8">
                                <TextBlock Text="文件哈希算法 - 基于文件内容的精确匹配" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, *">
                                    <Label Grid.Column="0" Content="哈希算法:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" 
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="MD5" />
                                        <ComboBoxItem Content="SHA1" />
                                        <ComboBoxItem Content="SHA256" />
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="窗口大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.WindowSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="3" Maximum="21" 
                                          TickFrequency="2" 
                                          IsSnapToTickEnabled="True"
                                          Value="{Binding AlgorithmParameters.WindowSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" 
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- aHash 算法 -->
                        <TabItem Header="aHash">
                            <StackPanel Spacing="8">
                                <TextBlock Text="平均哈希 - 基于图像平均值的哈希算法" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="4" Maximum="16" 
                                          Value="{Binding AlgorithmParameters.HashSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希权重:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashWeight, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="0" Maximum="100"
                                          Value="{Binding AlgorithmParameters.HashWeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- dHash 算法 -->
                        <TabItem Header="dHash">
                            <StackPanel Spacing="8">
                                <TextBlock Text="差异哈希 - 基于图像梯度的哈希算法" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="4" Maximum="16" 
                                          Value="{Binding AlgorithmParameters.HashSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希权重:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashWeight, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="0" Maximum="100"
                                          Value="{Binding AlgorithmParameters.HashWeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- pHash 算法 -->
                        <TabItem Header="pHash">
                            <StackPanel Spacing="8">
                                <TextBlock Text="感知哈希 - 基于DCT变换的哈希算法" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="4" Maximum="16" 
                                          Value="{Binding AlgorithmParameters.HashSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="哈希权重:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HashWeight, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="0" Maximum="100"
                                          Value="{Binding AlgorithmParameters.HashWeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="窗口大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.WindowSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="3" Maximum="21" 
                                          TickFrequency="2" 
                                          IsSnapToTickEnabled="True"
                                          Value="{Binding AlgorithmParameters.WindowSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- FastDup 算法 -->
                        <TabItem Header="FastDup">
                            <StackPanel Spacing="8">
                                <TextBlock Text="快速去重 - 基于缩略图的快速相似度检测" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="缩略图大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.ThumbSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="32" Maximum="256" 
                                          Value="{Binding AlgorithmParameters.ThumbSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Histogram 算法 -->
                        <TabItem Header="Histogram">
                            <StackPanel Spacing="8">
                                <TextBlock Text="直方图 - 基于颜色直方图的相似度匹配" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="直方图箱数:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Bins}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="32" Maximum="256" 
                                          Value="{Binding AlgorithmParameters.Bins}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="窗口大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.WindowSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="3" Maximum="21" 
                                          TickFrequency="2" 
                                          IsSnapToTickEnabled="True"
                                          Value="{Binding AlgorithmParameters.WindowSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Template 算法 -->
                        <TabItem Header="Template">
                            <StackPanel Spacing="8">
                                <TextBlock Text="模板匹配 - 基于模板匹配的相似度检测" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="窗口大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.WindowSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="3" Maximum="21" 
                                          TickFrequency="2" 
                                          IsSnapToTickEnabled="True"
                                          Value="{Binding AlgorithmParameters.WindowSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="块大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.BlockSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="50" Maximum="400" 
                                          Value="{Binding AlgorithmParameters.BlockSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- SSIM 算法 -->
                        <TabItem Header="SSIM">
                            <StackPanel Spacing="8">
                                <TextBlock Text="结构相似性 - 基于结构相似性的图像质量评估" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="窗口大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.WindowSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="3" Maximum="21" 
                                          TickFrequency="2" 
                                          IsSnapToTickEnabled="True"
                                          Value="{Binding AlgorithmParameters.WindowSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="块大小:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.BlockSize}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="50" Maximum="400" 
                                          Value="{Binding AlgorithmParameters.BlockSize}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- SIFT 算法 -->
                        <TabItem Header="SIFT">
                            <StackPanel Spacing="8">
                                <TextBlock Text="尺度不变特征变换 - 基于局部特征点的匹配" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="特征点数:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Features}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="100" Maximum="5000" 
                                          TickFrequency="100"
                                          Value="{Binding AlgorithmParameters.Features}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="最小匹配数:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.MinMatch}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="4" Maximum="50" 
                                          Value="{Binding AlgorithmParameters.MinMatch}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- SURF 算法 -->
                        <TabItem Header="SURF">
                            <StackPanel Spacing="8">
                                <TextBlock Text="加速稳健特征 - 快速鲁棒的特征检测" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="Hessian阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.HessianThreshold}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="100" Maximum="5000" 
                                          TickFrequency="100"
                                          Value="{Binding AlgorithmParameters.HessianThreshold}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="最小匹配数:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.MinMatch}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="4" Maximum="50" 
                                          Value="{Binding AlgorithmParameters.MinMatch}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                        <!-- Lance 算法 -->
                        <TabItem Header="Lance">
                            <StackPanel Spacing="8">
                                <TextBlock Text="向量搜索 - 基于向量数据库的快速相似度搜索" 
                                         FontStyle="Italic" 
                                         Foreground="#666" />
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="相似度阈值:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2"
                                          Minimum="50" Maximum="100"
                                          Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="向量维度:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Dim}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="64" Maximum="512" 
                                          TickFrequency="64"
                                          Value="{Binding AlgorithmParameters.Dim}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="KNN参数:" VerticalAlignment="Center" />
                                    <Label Grid.Column="1" 
                                          Content="{Binding AlgorithmParameters.Knn}" 
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Center" />
                                    <Slider Grid.Column="2" 
                                          Minimum="1" Maximum="20" 
                                          Value="{Binding AlgorithmParameters.Knn}" />
                                </Grid>
                                <Grid ColumnDefinitions="120, 60, *">
                                    <Label Grid.Column="0" Content="排序方式:" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Grid.ColumnSpan="2"
                                            SelectedIndex="0">
                                        <ComboBoxItem Content="文件名" />
                                        <ComboBoxItem Content="文件大小" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </TabItem>

                    </TabControl>
                    </StackPanel>
                </Border>

                <!-- 控制按钮区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="控制操作" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <UniformGrid Columns="4" Rows="1">
                            <Button Content="载入图像"
                                   Classes="load"
                                   Command="{Binding LoadImagesCommand}"
                                   ToolTip.Tip="加载指定目录中的所有图像文件" />
                            <Button Content="计算特征"
                                   Classes="calculate"
                                   Command="{Binding CalculateFeaturesCommand}"
                                   ToolTip.Tip="计算所有图像的特征向量" />
                            <Button Content="比对"
                                   Classes="compare"
                                   Command="{Binding CompareFeaturesCommand}"
                                   ToolTip.Tip="比对图像特征并查找重复项" />
                            <Button Content="停止"
                                   Classes="stop"
                                   Command="{Binding StopCommand}"
                                   ToolTip.Tip="停止当前正在执行的操作" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 进度显示区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="进度" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <StackPanel Spacing="5">
                            <ProgressBar Value="{Binding Progress}" Maximum="100" />
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                      Content="{Binding StatusMessage}"
                                      HorizontalAlignment="Center"
                                      FontSize="11" />
                                <Label Grid.Column="1"
                                      Content="{Binding LoadedImageCount, StringFormat={} ({0} 个)}"
                                      Margin="5,0,0,0"
                                      FontSize="11"
                                      FontWeight="Bold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 执行去重按钮 -->
                <Button Content="执行去重" 
                       Classes="execute"
                       Command="{Binding ExecuteDeduplicationCommand}"
                       ToolTip.Tip="执行去重操作，删除或移动重复图像" />

                <!-- 日志输出区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <Grid ColumnDefinitions="*, 80, 80" Margin="0,0,0,5">
                            <TextBlock Grid.Column="0" Text="日志" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                  Content="清空"
                                  Classes="browse"
                                  Command="{Binding ClearLogCommand}"
                                  Margin="2,0"
                                  ToolTip.Tip="清空日志" />
                            <Button Grid.Column="2"
                                  Content="导出"
                                  Classes="browse"
                                  Command="{Binding ExportLogCommand}"
                                  Margin="2,0"
                                  ToolTip.Tip="导出日志到文件" />
                        </Grid>
                        <TextBox Text="{Binding LogText}"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="150"
                                MaxHeight="150"
                                VerticalAlignment="Stretch"
                                FontFamily="Consolas"
                                FontSize="9" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 右侧预览面板 -->
        <Border Grid.Column="1" 
               BorderBrush="#ccc" 
               BorderThickness="1,0,0,0"
               Background="#f9f9f9">
            <StackPanel Margin="10" Spacing="10">
                
                <!-- 导航按钮区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="导航" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <Grid ColumnDefinitions="*, 80, *">
                            <Button Grid.Column="0"
                                   Content="◄ 上一个"
                                   Classes="navigate"
                                   Command="{Binding NavigatePreviousCommand}" />
                            <TextBlock Grid.Column="1"
                                  Text="{Binding NavigationText}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="11" />
                            <Button Grid.Column="2"
                                   Content="下一个 ►"
                                   Classes="navigate"
                                   Command="{Binding NavigateNextCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 文件列表区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="原图列表" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <ListBox x:Name="originalListBox"
                                 ItemsSource="{Binding OriginalListSource}"
                                 SelectedItem="{Binding SelectedImage}"
                                 MinHeight="150" MaxHeight="200">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" 
                                              FontSize="10"
                                              ToolTip.Tip="{Binding FilePath}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="重复图像列表" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <ListBox x:Name="duplicateListBox"
                                 ItemsSource="{Binding CurrentDuplicates}"
                                 SelectedItem="{Binding SelectedDuplicate}"
                                 MinHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 60">
                                        <TextBlock Grid.Column="0" 
                                                  Text="{Binding FileName}"
                                                  FontSize="10"
                                                  ToolTip.Tip="{Binding Path}"
                                                  TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" 
                                                  Text="{Binding Similarity, StringFormat={}{0:F3}}"
                                                  FontSize="10"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="原图对调"
                                         Command="{Binding SwapWithOriginalCommand}"
                                         ToolTip.Tip="将此重复图像与原图对调" />
                                    <Separator />
                                    <MenuItem Header="移出"
                                         Command="{Binding RemoveFromListCommand}"
                                         ToolTip.Tip="从重复列表中移除此图像" />
                                    <MenuItem Header="删除"
                                         Command="{Binding DeleteDuplicateFileCommand}"
                                         ToolTip.Tip="删除重复图像(移入回收站)" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- 图像预览区域 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="图像预览" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto">
                        <!-- 原图预览框 -->
                        <Border Grid.Column="0" Grid.Row="0"
                               BorderBrush="#ccc" 
                               BorderThickness="2"
                               Background="#f5f5f5"
                               Margin="2"
                               Height="120">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="原图" 
                                          HorizontalAlignment="Center" 
                                          FontSize="10" 
                                          Foreground="#666"
                                          Margin="0,2" />
                                <Image Grid.Row="1"
                                      Source="{Binding SelectedImageBitmap}"
                                      Stretch="Uniform"
                                      Margin="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- 原图文件名（框外） -->
                        <TextBlock Grid.Column="0" Grid.Row="1"
                                  Text="{Binding SelectedImage.FileName}" 
                                  FontSize="9" 
                                  TextWrapping="Wrap"
                                  TextTrimming="CharacterEllipsis"
                                  Margin="2,2"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="{Binding SelectedImage.FilePath}" />

                        <!-- 重复图预览框 -->
                        <Border Grid.Column="1" Grid.Row="0"
                               BorderBrush="#ccc" 
                               BorderThickness="2"
                               Background="#f5f5f5"
                               Margin="2"
                               Height="120">
                            <Grid RowDefinitions="Auto, *">
                                <TextBlock Grid.Row="0" Text="重复图像" 
                                          HorizontalAlignment="Center" 
                                          FontSize="10" 
                                          Foreground="#666"
                                          Margin="0,2" />
                                <Image Grid.Row="1"
                                      Source="{Binding SelectedDuplicateImageData.BitmapImage}"
                                      Stretch="Uniform"
                                      Margin="2"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- 重复图文件名（框外） -->
                        <TextBlock Grid.Column="1" Grid.Row="1"
                                  Text="{Binding SelectedDuplicate.FileName}" 
                                  FontSize="9" 
                                  TextWrapping="Wrap"
                                  TextTrimming="CharacterEllipsis"
                                  Margin="2,2"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="{Binding SelectedDuplicate.Path}" />

                        <!-- 相似度信息 -->
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2"
                                  Text="{Binding SelectedDuplicate.Similarity, StringFormat='相似度: {0:F3}'}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="11"
                                  FontWeight="Bold"
                                  Foreground="#666"
                                  Margin="0,5" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 底部操作按钮 -->
                <Border BorderBrush="#ccc" BorderThickness="1" Padding="5" Margin="5">
                    <StackPanel>
                        <TextBlock Text="操作" FontWeight="Bold" Margin="0,0,0,5" FontSize="11" />
                        <UniformGrid Columns="2" Rows="1">
                            <Button Content="撤回删除"
                                   Classes="undo"
                                   Command="{Binding UndoDeleteCommand}"
                                   ToolTip.Tip="从回收站恢复已删除的文件" />
                            <Button Content="删除重复"
                                   Classes="delete"
                                   Command="{Binding DeleteDuplicateCommand}"
                                   ToolTip.Tip="删除当前选中的重复图像" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>

    </Grid>

</Window>
