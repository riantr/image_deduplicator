<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Deduplicator.ViewModels"
        xmlns:models="using:Deduplicator.Models"
        xmlns:converters="using:Deduplicator.Converters"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="860"
        x:Class="Deduplicator.Views.MainWindow"
        Title="图像去重工具"
        Width="1440" Height="860"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceAltBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!--
  算法参数面板的显示控制。

        重构前，11 种算法各有 4~5 个 Tab 页，参数面板重复约 600 行 XAML，
        每新增一个参数就要改 11 处。改为「一个下拉框 + 按算法动态显示字段」。
     -->
        <converters:ShowHashSizeConverter x:Key="ShowHashSize" />
        <converters:ShowHashWeightConverter x:Key="ShowHashWeight" />
        <converters:ShowWindowSizeConverter x:Key="ShowWindowSize" />
        <converters:ShowThumbSizeConverter x:Key="ShowThumbSize" />
        <converters:ShowBinsConverter x:Key="ShowBins" />
        <converters:ShowBlockSizeConverter x:Key="ShowBlockSize" />
        <converters:ShowFeaturesConverter x:Key="ShowFeatures" />
        <converters:ShowMinMatchConverter x:Key="ShowMinMatch" />
        <converters:ShowHessianConverter x:Key="ShowHessian" />
        <converters:ShowDimConverter x:Key="ShowDim" />
        <converters:ShowKnnConverter x:Key="ShowKnn" />
        <converters:AlgorithmDescriptionConverter x:Key="DescriptionText" />
        <converters:NullToVisibilityConverter x:Key="IsNull" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══════════════ 顶部标题栏 ══════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="6">
                        <TextBlock Text="重" Foreground="White"
                                   FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="图像去重工具" Classes="h2"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 主流程：把三步显式化，让用户知道自己在哪一步 -->
                <Border Grid.Column="1" HorizontalAlignment="Center"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="8" Padding="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Border Classes="step" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="1" Classes="stepNum" />
                                <TextBlock Text="载入图像" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="—" Classes="muted" VerticalAlignment="Center" />
                        <Border Classes="step" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="2" Classes="stepNum" />
                                <TextBlock Text="计算特征" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="—" Classes="muted" VerticalAlignment="Center" />
                        <Border Classes="step" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="3" Classes="stepNum" />
                                <TextBlock Text="查找重复" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 已载入数量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Classes="caption" VerticalAlignment="Center"
                               Text="{Binding LoadedImageCount, StringFormat='已载入 {0} 张'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ 主内容区 ══════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="360,*" Margin="16">

            <!-- ─────── 左：控制面板 ─────── -->
            <Grid Grid.Column="0" Margin="0,0,16,0" RowDefinitions="*,Auto">

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <!-- ═══ 目录 ═══ -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="目录" Classes="section" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="输入目录" Classes="caption" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Watermark="选择包含图像的目录"
                                                 Text="{Binding InputDirectory}" />
                                        <Button Grid.Column="1" Content="浏览"
                                                Classes="subtle"
                                                Click="BrowseInputDirectory_Click" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="输出目录" Classes="caption" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 Watermark="留空表示不移动文件"
                                                 Text="{Binding OutputDirectory}" />
                                        <Button Grid.Column="1" Content="浏览"
                                                Classes="subtle"
                                                Click="BrowseOutputDirectory_Click" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 算法 ═══ -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">

                                <StackPanel Spacing="6">
                                    <TextBlock Text="算法" Classes="section" Margin="0" />
                                    <ComboBox SelectedIndex="{Binding CurrentAlgorithm}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="FileHash · 文件哈希" />
                                        <ComboBoxItem Content="DHash · 差异哈希（推荐）" />
                                        <ComboBoxItem Content="AHash · 平均哈希" />
                                        <ComboBoxItem Content="PHash · 感知哈希" />
                                        <ComboBoxItem Content="FastDup · 快速去重" />
                                        <ComboBoxItem Content="Histogram · 颜色直方图" />
                                        <ComboBoxItem Content="Template · 模板匹配" />
                                        <ComboBoxItem Content="SSIM · 结构相似度" />
                                        <ComboBoxItem Content="SIFT · 尺度不变特征" />
                                        <ComboBoxItem Content="SURF(ORB) · 快速特征" />
                                        <ComboBoxItem Content="Lance · 向量检索" />
                                    </ComboBox>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="{Binding CurrentAlgorithm, Converter={StaticResource DescriptionText}}" />
                                </StackPanel>

                                <Separator />

                                <!-- ═══ 相似度阈值：所有算法都有 ═══ -->
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="相似度阈值"
                                                   Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.Threshold, StringFormat={}{0:F2}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="30" Maximum="100"
                                            IsSnapToTickEnabled="False"
                                            Value="{Binding AlgorithmParameters.Threshold, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </StackPanel>

                                <!-- ═══ 以下参数按算法动态显示 ═══ -->

                                <!-- 哈希大小：FileHash/AHash/DHash/PHash -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowHashSize}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="哈希大小" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.HashSize}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="4" Maximum="16" TickFrequency="4"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AlgorithmParameters.HashSize}" />
                                </StackPanel>

                                <!-- 哈希权重：AHash/DHash -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowHashWeight}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="哈希权重" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.HashWeight, StringFormat={}{0:F2}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="0" Maximum="100"
                                            Value="{Binding AlgorithmParameters.HashWeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=100}" />
                                </StackPanel>

                                <!-- 窗口大小：多算法共用 -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowWindowSize}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="窗口大小" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.WindowSize}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="3" Maximum="21" TickFrequency="2"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AlgorithmParameters.WindowSize}" />
                                </StackPanel>

                                <!-- 缩略图大小：FastDup -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowThumbSize}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="缩略图大小" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.ThumbSize}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="32" Maximum="256" TickFrequency="32"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AlgorithmParameters.ThumbSize}" />
                                </StackPanel>

                                <!-- 直方图箱数：Histogram -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowBins}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="直方图箱数" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.Bins}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="32" Maximum="256" TickFrequency="32"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AlgorithmParameters.Bins}" />
                                </StackPanel>

                                <!-- 块大小：Template/SSIM -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowBlockSize}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="匹配块大小" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.BlockSize}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="50" Maximum="400" TickFrequency="50"
                                            Value="{Binding AlgorithmParameters.BlockSize}" />
                                </StackPanel>

                                <!-- 特征点数：SIFT/SURF -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowFeatures}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="特征点数上限" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.Features}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="100" Maximum="5000" TickFrequency="100"
                                            Value="{Binding AlgorithmParameters.Features}" />
                                </StackPanel>

                                <!-- 最小匹配数：SIFT/SURF -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowMinMatch}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="判定重复所需匹配数" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.MinMatch}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="4" Maximum="50"
                                            Value="{Binding AlgorithmParameters.MinMatch}" />
                                </StackPanel>

                                <!-- Hessian 阈值：SURF 专属 -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowHessian}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Hessian 阈值" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.HessianThreshold}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="100" Maximum="5000" TickFrequency="100"
                                            Value="{Binding AlgorithmParameters.HessianThreshold}" />
                                </StackPanel>

                                <!-- 向量维度：Lance -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowDim}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="向量维度" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.Dim}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="64" Maximum="512" TickFrequency="64"
                                            Value="{Binding AlgorithmParameters.Dim}" />
                                </StackPanel>

                                <!-- KNN 参数：Lance -->
                                <StackPanel Spacing="4"
                                            IsVisible="{Binding CurrentAlgorithm, Converter={StaticResource ShowKnn}}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="近邻数 K" Classes="caption" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AlgorithmParameters.Knn}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Slider Minimum="1" Maximum="20"
                                            Value="{Binding AlgorithmParameters.Knn}" />
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ═══ 日志 ═══ -->
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="运行日志" Classes="section"
                                               Margin="0" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="清空" Classes="ghost subtle"
                                            Command="{Binding ClearLogCommand}"
                                            ToolTip.Tip="清空当前日志" />
                                    <Button Grid.Column="2" Content="导出" Classes="ghost subtle"
                                            Command="{Binding ExportLogCommand}"
                                            ToolTip.Tip="导出日志到文件" />
                                </Grid>
                                <TextBox Text="{Binding LogText}" Classes="log"
                                         Height="130" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- ═══ 底部：主操作 ═══ -->
                <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="载入图像" Classes="accent" HorizontalAlignment="Stretch"
                                    Command="{Binding LoadImagesCommand}"
                                    ToolTip.Tip="扫描输入目录中的所有图像" />
                            <Button Content="计算特征" HorizontalAlignment="Stretch"
                                    Command="{Binding CalculateFeaturesCommand}"
                                    ToolTip.Tip="按所选算法提取特征" />
                            <Button Content="查找重复" HorizontalAlignment="Stretch"
                                    Command="{Binding CompareFeaturesCommand}"
                                    ToolTip.Tip="比对特征，找出重复图像" />
                        </StackPanel>
                        <Button Content="执行去重" Classes="accent large"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ExecuteDeduplicationCommand}"
                                ToolTip.Tip="对已标记的重复项执行删除或移动" />
                        <Button Content="停止" Classes="ghost"
                                HorizontalAlignment="Stretch"
                                Command="{Binding StopCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ─────── 右：对比工作区 ─────── -->
            <Border Grid.Column="1" Classes="card" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- 工作区标题 + 导航 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,14,8">
                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="对比工作区" Classes="h2" />
                            <TextBlock Classes="caption"
                                       Text="{Binding NavigationText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Button Classes="ghost" Content="◀"
                                    Command="{Binding NavigatePreviousCommand}"
                                    ToolTip.Tip="上一组 (Shift+↑)" />
                            <Button Classes="ghost" Content="▶"
                                    Command="{Binding NavigateNextCommand}"
                                    ToolTip.Tip="下一组 (Shift+↓)" />
                        </StackPanel>
                    </Grid>

                    <!-- 对比区 -->
                    <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="14,0,14,8">

                        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto">

                            <!-- 原图 -->
                            <Border Grid.Column="0" Classes="preview" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Padding="10,7"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="原图" Classes="section"
                                                       Margin="0" />
                                            <TextBlock Grid.Column="1" Classes="caption"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SelectedImage.Width, StringFormat={}{0} px}" />
                                        </Grid>
                                    </Border>
                                    <Panel Grid.Row="1">
                                        <Image Source="{Binding SelectedImageBitmap}"
                                               Stretch="Uniform" Margin="8" />
                                        <!-- 空状态 -->
                                        <StackPanel IsVisible="{Binding SelectedImage, Converter={StaticResource IsNull}}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="未选择图像" Classes="muted"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                    <!-- 文件名条 -->
                                    <Border Grid.Row="0" VerticalAlignment="Bottom"
                                            IsVisible="False" />
                                </Grid>
                            </Border>

                            <!-- 重复图 -->
                            <Border Grid.Column="1" Classes="preview" ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Padding="10,7"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="重复图像" Classes="section"
                                                       Margin="0" />
                                            <!-- 相似度徽章 -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource SurfaceSunkenBrush}"
                                                    CornerRadius="4" Padding="8,2">
                                                <TextBlock FontWeight="SemiBold" FontSize="13"
                                                           Text="{Binding SelectedDuplicate.Similarity, StringFormat='{}{0:P1}'}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Panel Grid.Row="1">
                                        <Image Source="{Binding SelectedDuplicateImageData.BitmapImage}"
                                               Stretch="Uniform" Margin="8" />
                                        <StackPanel IsVisible="{Binding SelectedDuplicate, Converter={StaticResource IsNull}}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="未选择重复项" Classes="muted"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Panel>
                                </Grid>
                            </Border>

                            <!-- 重复项列表 -->
                            <Border Grid.Column="2" Classes="preview" Width="220">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" Padding="10,7"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="重复项" Classes="section"
                                                       Margin="0" />
                                            <TextBlock Grid.Column="1" Classes="caption"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CurrentDuplicates.Count, StringFormat='{}{0} 项'}" />
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding CurrentDuplicates}"
                                             SelectedItem="{Binding SelectedDuplicate}"
                                             Margin="6">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="移出列表"
                                                    Command="{Binding RemoveFromListCommand}" />
                                                <MenuItem Header="删除此文件"
                                                          Command="{Binding DeleteDuplicateFileCommand}" />
                                                <Separator />
                                                <MenuItem Header="与原图对调"
                                                    Command="{Binding SwapWithOriginalCommand}" />
                                                <MenuItem Header="用此替换原图"
                                                          Command="{Binding ReplaceImagesCommand}" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip.Tip="{Binding Path}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Similarity, StringFormat={}{0:F2}}"
                                                               Classes="caption"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 文件信息条 -->
                        <Grid Grid.Row="1" ColumnDefinitions="*,*"
                              Margin="0,10,0,0">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding SelectedImage.FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SelectedImage.FilePath}" />
                                <TextBlock Classes="caption"
                                           Text="{Binding SelectedImage.FileSize, StringFormat='{}{0:N0} 字节'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding SelectedDuplicate.FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding SelectedDuplicate.Path}" />
                                <TextBlock Classes="caption"
                                           Text="{Binding StatusMessage}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 底部操作栏 -->
                    <Border Grid.Row="2" Padding="14,12"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,10,10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Classes="caption"
                                       VerticalAlignment="Center"
                                       Text="Shift+↑ / Shift+↓ 切换组" />

                            <Button Grid.Column="1" Content="对调文件名"
                                    Command="{Binding SwapWithOriginalCommand}"
                                    ToolTip.Tip="交换原图与选中重复项的文件名" />
                            <Button Grid.Column="2" Content="撤回删除"
                                    Command="{Binding UndoDeleteCommand}"
                                    ToolTip.Tip="从回收站恢复已删除的文件" />
                            <Button Grid.Column="3" Content="删除重复" Classes="danger"
                                    Command="{Binding DeleteDuplicateCommand}"
                                    ToolTip.Tip="删除当前重复项（移入回收站，可撤回）" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════ 状态栏 ══════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" />
                    <ProgressBar Width="140" Height="4"
                                 Value="{Binding Progress}" Maximum="100" />
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="caption"
                           VerticalAlignment="Center"
                           Text="{Binding LoadedImageCount, StringFormat='{}{0} 张图像'}" />
            </Grid>
        </Border>
    </Grid>
</Window>