<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Deduplicator.Views.ImageListWindow"
        Title="图像列表"
        Width="900" Height="700"
        MinWidth="600" MinHeight="400"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei" FontSize="10">

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        
        <Style Selector="DataGrid">
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Window.Styles>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0" 
                BorderBrush="#ccc" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,10"
                Background="#f5f5f5">
            <StackPanel>
                <TextBlock Text="已加载图像列表" 
                          FontSize="16" 
                          FontWeight="Bold" 
                          Margin="0,0,0,5" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="StatusText" 
                              Text="正在加载图像..." 
                              Foreground="#666" />
                    <TextBlock x:Name="CountText"
                              Text="数量: 0"
                              Foreground="#0066CC"
                              FontWeight="Bold" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 图像列表区域 -->
        <Border Grid.Row="1" 
                BorderBrush="#333" 
                BorderThickness="2" 
                Padding="5"
                Background="White">
            <ScrollViewer>
                <ItemsControl x:Name="ImageItemsControl" ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#ccc" BorderThickness="0,0,0,1" Padding="5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" Width="200"/>
                                    <TextBlock Text="{Binding FilePath}" Foreground="#666"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮区域 -->
        <Border Grid.Row="2" 
                BorderBrush="#ccc" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,10,0,0"
                Background="#f9f9f9">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       Spacing="10">
                <Button Content="刷新" 
                       Width="80" 
                       Height="35" 
                       Click="RefreshButton_Click"
                       Background="#4CAF50"
                       Foreground="White"
                       FontWeight="Bold" />
                <Button Content="预览选中图像" 
                       Width="120" 
                       Height="35" 
                       Click="PreviewButton_Click"
                       Background="#2196F3"
                       Foreground="White"
                       FontWeight="Bold" />
                <Button Content="关闭" 
                       Width="80" 
                       Height="35" 
                       Click="CloseButton_Click"
                       Background="#9E9E9E"
                       Foreground="White"
                       FontWeight="Bold" />
            </StackPanel>
        </Border>
    </Grid>

</Window>